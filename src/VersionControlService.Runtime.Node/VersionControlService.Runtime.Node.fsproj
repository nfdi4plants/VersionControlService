<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>VersionControlService.Runtime.Node</PackageId>
    <Description>Node/Fable runtime adapters (filesystem, process, cancellation) for VersionControlService providers.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="FileSystem.fs" />
    <Compile Include="Path.fs" />
    <Compile Include="Interop.fs" />
    <Compile Include="SimpleGit.fs" />
    <Compile Include="Cancellation.fs" />
    <Compile Include="Process.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VersionControlService.Abstractions\VersionControlService.Abstractions.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Core" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="*.fsproj; *.fs" PackagePath="fable\" />
  </ItemGroup>
</Project>
