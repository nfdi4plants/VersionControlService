<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>VersionControlService.Git</PackageId>
    <Description>Git and Git LFS provider for VersionControlService workspace sessions.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Git\GitEngineTypes.fs" />
    <Compile Include="Support\PathHelpers.fs" />
    <Compile Include="Support\FileSystemIO.fs" />
    <Compile Include="Git\JsonDecoder.fs" />
    <Compile Include="Git\GitCommandResolver.fs" />
    <Compile Include="Git\GitAuthAdapter.fs" />
    <Compile Include="Git\GitLfsAdapter.fs" />
    <Compile Include="Git\GitLfsService.fs" />
    <Compile Include="Git\GitTokenProvider.fs" />
    <Compile Include="Git\GitInternals.fs" />
    <Compile Include="GitPathTransport.fs" />
    <Compile Include="Git\GitService.fs" />
    <Compile Include="Git\GitProvisioningService.fs" />
    <Compile Include="GitCredentialStrategy.fs" />
    <Compile Include="GitRefs.fs" />
    <Compile Include="GitConflictSession.fs" />
    <Compile Include="GitLfsExtensions.fs" />
    <Compile Include="GitSelectedRevision.fs" />
    <Compile Include="GitWorkspaceSession.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VersionControlService.Abstractions\VersionControlService.Abstractions.fsproj" />
    <ProjectReference Include="..\VersionControlService.Runtime.Node\VersionControlService.Runtime.Node.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Core" />
    <PackageReference Include="Fable.Promise" />
    <PackageReference Include="Thoth.Json.JavaScript" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="VersionControlService.Git.fsproj" Pack="true" PackagePath="fable\" />
    <Content Include="**\*.fs" Exclude="bin\**;obj\**" Pack="true" PackagePath="fable\" />
  </ItemGroup>
</Project>
