<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>VersionControlService.TextDiff</PackageId>
    <Description>Pure incremental text decoding and scanning primitives for VersionControlService.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Native.fs" />
    <Compile Include="Host.fs" />
    <Compile Include="Meter.fs" />
    <Compile Include="Myers.fs" />
    <Compile Include="Hash.fs" />
    <Compile Include="Decoders.fs" />
    <Compile Include="Scanner.fs" />
    <Compile Include="CommonRun.fs" />
    <Compile Include="Classification.fs" />
    <Compile Include="Ledger.fs" />
    <Compile Include="SessionContracts.fs" />
    <Compile Include="Snapshot.fs" />
    <Compile Include="Checkpoints.fs" />
    <Compile Include="Journal.fs" />
    <Compile Include="DiffPlan.fs" />
    <Compile Include="HunkBuilder.fs" />
    <Compile Include="LineCompare.fs" />
    <Compile Include="SampledIndex.fs" />
    <Compile Include="Resync.fs" />
    <Compile Include="WorkerScratch.fs" />
    <Compile Include="TextDiffSession.fs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VersionControlService.TextDiff.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VersionControlService.Abstractions\VersionControlService.Abstractions.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Core" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="VersionControlService.TextDiff.fsproj" Pack="true" PackagePath="fable\" />
    <Content Include="**\*.fs" Exclude="bin\**;obj\**" Pack="true" PackagePath="fable\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
