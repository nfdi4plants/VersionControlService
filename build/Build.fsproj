<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ProjectInfo.fs"/>
    <Compile Include="Util.fs"/>
    <Compile Include="IO\Changelog.fs"/>
    <Compile Include="IO\PackageIO.fs"/>
    <Compile Include="Tools\Docker.fs"/>
    <Compile Include="Actions\Test.fs"/>
    <Compile Include="Actions\Pack.fs"/>
    <Compile Include="Actions\Verify.fs"/>
    <Compile Include="Actions\Release.fs"/>
    <Compile Include="Actions\Consumer.fs"/>
    <Compile Include="Actions\LakeFs.fs"/>
    <Compile Include="Build.fs"/>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SimpleExec" Version="12.0.0"/>
    <PackageReference Include="Semver" Version="3.0.0"/>
    <PackageReference Include="FsToolkit.ErrorHandling" Version="5.1.0"/>
    <PackageReference Update="FSharp.Core" Version="9.0.300"/>
  </ItemGroup>
</Project>
